OPENAI_API_KEY=
# Optional. If blank, the Agents SDK default model configuration is used.
OPENAI_AGENT_MODEL=
MAX_PARALLEL_AGENTS=8
AGENT_CONFIG_PATH=config/agents.yaml

# Required only to enable SEC Company Facts enrichment for US equities.
# SEC asks automated clients to identify the application/contact.
SEC_USER_AGENT=
SEC_TIMEOUT_SECONDS=15

# Optional US stock/ETF market-data enrichment.
# Raw OHLCV is fetched unadjusted; corporate actions are stored separately.
MASSIVE_API_KEY=
MASSIVE_TIMEOUT_SECONDS=15
MASSIVE_LOOKBACK_DAYS=400

# Optional immutable audit persistence. If configured, database write failures
# are surfaced instead of silently returning an unaudited report.
DATABASE_URL=
DATABASE_SCHEMA_PATH=db/schema.sql

# EDINET API v2 credentials used by the daily filing-index sync job.
# Runtime Japanese-equity enrichment reads the local PostgreSQL index.
EDINET_API_KEY=
EDINET_TIMEOUT_SECONDS=30
EDINET_INDEX_LIMIT=8
