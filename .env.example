OPENAI_API_KEY=
# Optional. If blank, the Agents SDK default model configuration is used.
OPENAI_AGENT_MODEL=
MAX_PARALLEL_AGENTS=8
AGENT_CONFIG_PATH=config/agents.yaml

# HTTP process / reverse proxy settings.
PORT=8000
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=*

# Public REST API.
API_NAME=Investment Research API
API_VERSION=1.0.0
API_DOCS_ENABLED=true
# Fail process startup unless DATABASE_URL is reachable and OpenAI/API auth are configured.
# Keep false for local development; enable in production.
STRICT_STARTUP_READINESS=false
# Comma-separated SHA-256 hex digests of accepted X-API-Key values.
# Generate one with:
# python -c "import hashlib; print(hashlib.sha256(b'your-secret-key').hexdigest())"
# If blank, authentication is disabled for local development only.
PUBLIC_API_KEY_HASHES=

# Required only to enable SEC Company Facts enrichment for US equities.
# SEC asks automated clients to identify the application/contact.
SEC_USER_AGENT=
SEC_TIMEOUT_SECONDS=15

# Optional US stock/ETF market-data enrichment.
# Raw OHLCV is fetched unadjusted; corporate actions are stored separately.
MASSIVE_API_KEY=
MASSIVE_TIMEOUT_SECONDS=15
MASSIVE_LOOKBACK_DAYS=400

# Required by POST /v1/research and GET /v1/reports/{request_id}.
# Public research fails closed if durable audit/idempotency storage is unavailable.
DATABASE_URL=
DATABASE_SCHEMA_PATH=db/schema.sql

# EDINET API v2 credentials used by the daily filing-index sync job.
# Runtime Japanese-equity enrichment reads the local PostgreSQL index.
EDINET_API_KEY=
EDINET_TIMEOUT_SECONDS=30
EDINET_INDEX_LIMIT=8
